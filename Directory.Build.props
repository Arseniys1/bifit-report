<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Значение по умолчанию для локальной сборки; релизный скрипт
         переопределяет его через -p:Version=<версия>. -->
    <Version>1.0.0</Version>
    <Product>BIFIT Report</Product>
    <Company>BIFIT Report</Company>
    <Copyright>Copyright © BIFIT Report</Copyright>
  </PropertyGroup>
</Project>
