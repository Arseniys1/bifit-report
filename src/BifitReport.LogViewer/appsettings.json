{
  "Server": {
    "ListenUrl": "http://127.0.0.1:5080",
    "CertificateThumbprint": ""
  },
  "Access": {
    "AllowedPrincipals": [
      "S-1-5-32-544"
    ]
  },
  "LogViewer": {
    "Sources": [
      {
        "Id": "bifit",
        "DisplayName": "БИФИТ Касса",
        "RootPath": "C:\\ProgramData\\BIFIT\\retail\\logs",
        "Includes": [
          "**/*.log",
          "**/*.log.gz"
        ],
        "Recursive": true
      }
    ],
    "DefaultTailLines": 500,
    "MaximumTailLines": 2000,
    "MaximumCatalogFiles": 5000,
    "MaximumScanBytes": 8388608,
    "MaximumLiveReadBytes": 1048576,
    "MaximumLineCharacters": 262144,
    "MaximumCompressedFileBytes": 134217728,
    "MaximumDecompressedFileBytes": 536870912,
    "AllowRawLogs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\BifitReport\\LogViewer\\logs\\viewer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
